# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Airtable personal access token. Required scopes:
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
# and access to the "Fireside Chat (TM241)" base.
AIRTABLE_TOKEN=

# Optional: defaults to the Fireside Chat (TM241) base (app62Sl4pVXVuGNsI).
AIRTABLE_BASE_ID=

# Optional: the table that stores registrations. Use the table ID (starts with "tbl") so renaming
# the table in Airtable does not break the form. Defaults to "Fireside Chat Registrations" (tblq0AzB7jqkQvnJu).
AIRTABLE_TABLE_ID=

# Password for the results dashboard at /dashboard
DASHBOARD_PASSWORD=

# Optional: a second password that opens only the check-in desk at /checkin, for volunteers at the
# door. It can verify tickets and mark attendance but cannot see the dashboard or exports.
# Without it, the check-in desk opens with DASHBOARD_PASSWORD.
CHECKIN_PASSWORD=

# Optional: random string used to sign dashboard sessions (e.g. 32+ random characters).
# If omitted, one is derived from the password and token.
SESSION_SECRET=

# Optional: email every registrant their boarding pass (with its QR code) right after they register.
# Gmail is the default. SMTP_USER = the Gmail address the emails come from (ideally a class/event account).
# SMTP_PASS = an "App password" for that account, NOT its normal password: turn on 2-Step Verification,
# then create one at https://myaccount.google.com/apppasswords (16 letters; spaces don't matter).
# Gmail sends up to about 500 emails a day. Without these two, registration still works, minus the email.
SMTP_USER=
SMTP_PASS=

# Optional, only for a provider other than Gmail (Outlook, Brevo, Resend, a university mail server):
SMTP_HOST=
SMTP_PORT=
# The sender shown to registrants, e.g. "TM241 Fireside Chat <tm241.firesidechat@gmail.com>".
# Needed only when SMTP_USER is not an email address (e.g. Resend, whose login is "resend").
EMAIL_FROM=
# Where replies go, if not to the sending address.
EMAIL_REPLY_TO=
